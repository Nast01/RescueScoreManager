<UserControl x:Class="RescueScoreManager.Modules.Planning.Views.PlanningProgramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RescueScoreManager.Localization"
             xmlns:viewModels="clr-namespace:RescueScoreManager.Modules.Planning.ViewModels"
             Background="White">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    
    <!-- Top Toolbar -->
    <Border Grid.Row="0" Background="#F3F4F6" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB" Padding="10">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="AddSiteButton" 
                Content="Add Site" 
                Margin="0,0,10,0" 
                Padding="12,6"
                Background="#10B981" 
                Foreground="White" 
                BorderThickness="0"
                Command="{Binding AddSiteCommand}"/>
        
        <Button x:Name="AddMeetingButton" 
                Content="Add Meeting" 
                Margin="0,0,10,0" 
                Padding="12,6"
                Background="#3B82F6" 
                Foreground="White" 
                BorderThickness="0"
                Command="{Binding AddMeetingCommand}"/>
        
        <Separator Margin="10,0"/>
        
        <Button x:Name="ValidateButton" 
                Content="Validate Schedule" 
                Margin="0,0,10,0" 
                Padding="12,6"
                Background="#F59E0B" 
                Foreground="White" 
                BorderThickness="0"
                Command="{Binding ValidateCommand}"/>
        
        <Button x:Name="PublishButton" 
                Content="Publish" 
                Margin="0,0,10,0" 
                Padding="12,6"
                Background="#EF4444" 
                Foreground="White" 
                BorderThickness="0"
                Command="{Binding PublishCommand}"
                IsEnabled="{Binding CanPublish}"/>
        
        <Separator Margin="10,0"/>
        
        <TextBlock Text="Status:" 
                   VerticalAlignment="Center" 
                   Margin="0,0,5,0" 
                   FontWeight="SemiBold"/>
        <TextBlock Text="{Binding CurrentProgram.Status}" 
                   VerticalAlignment="Center" 
                   Foreground="{Binding StatusColor}"/>
        
        <TextBlock Text="Version:" 
                   VerticalAlignment="Center" 
                   Margin="15,0,5,0" 
                   FontWeight="SemiBold"/>
        <TextBlock Text="{Binding CurrentProgram.Version}" 
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    
    <!-- Main Content Area -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      
      <!-- Left Sidebar - Available Events -->
      <Border Grid.Column="0" Background="#F9FAFB" BorderThickness="0,0,1,0" BorderBrush="#E5E7EB">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          
          <TextBlock Grid.Row="0" 
                     Text="Available Events" 
                     FontSize="16" 
                     FontWeight="Bold" 
                     Margin="10" 
                     Foreground="#374151"/>
          
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AvailableRaceFormats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" 
                          BorderBrush="#D1D5DB" 
                          Margin="5" 
                          Padding="8"
                          CornerRadius="4"
                          AllowDrop="True"
                          MouseLeftButtonDown="RaceFormat_MouseLeftButtonDown"
                          MouseMove="RaceFormat_MouseMove">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <!-- Men - Blue background -->
                          <DataTrigger Binding="{Binding RaceFormatConfiguration.Gender}" Value="Men">
                            <Setter Property="Background" Value="#E3F2FD"/>
                          </DataTrigger>
                          <!-- Woman - Pink background -->
                          <DataTrigger Binding="{Binding RaceFormatConfiguration.Gender}" Value="Woman">
                            <Setter Property="Background" Value="#FCE4EC"/>
                          </DataTrigger>
                          <!-- Mixte - Green background -->
                          <DataTrigger Binding="{Binding RaceFormatConfiguration.Gender}" Value="Mixte">
                            <Setter Property="Background" Value="#E8F5E8"/>
                          </DataTrigger>
                        </Style.Triggers>
                        <!-- Default background -->
                        <Setter Property="Background" Value="White"/>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      
                      <!-- NumberOfRun with background -->
                      <Border Grid.Column="0" 
                              Background="#3B82F6" 
                              CornerRadius="3" 
                              Padding="4,2" 
                              Margin="0,0,6,0"
                              VerticalAlignment="Stretch">
                        <TextBlock Text="{Binding NumberOfRun}" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>
                      
                      <!-- Labels -->
                      <StackPanel Grid.Column="1" Orientation="Vertical">
                        <TextBlock Text="{Binding Label}" 
                                   FontWeight="SemiBold" 
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding RaceFormatConfiguration.DisciplineLabel}" 
                                   FontSize="9" 
                                   Foreground="#9CA3AF" 
                                   FontStyle="Italic"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
      
      <GridSplitter Grid.Column="1" 
                    HorizontalAlignment="Stretch" 
                    Background="#E5E7EB"/>
      
      <!-- Main Timeline Area -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Timeline Header -->
        <Border Grid.Row="0" Background="#F3F4F6" BorderThickness="0,0,0,1" BorderBrush="#E5E7EB" Padding="10">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="Competition Schedule" 
                         FontSize="18" 
                         FontWeight="Bold" 
                         Foreground="#1F2937"/>
              <ComboBox x:Name="ViewModeCombo" 
                        Margin="20,0,0,0" 
                        Width="120"
                        SelectedValue="{Binding SelectedViewMode}">
                <ComboBoxItem Content="By Time"/>
                <ComboBoxItem Content="By Site"/>
                <ComboBoxItem Content="By Day"/>
              </ComboBox>
            </StackPanel>
            
            <!-- Date Navigation -->
            <StackPanel Orientation="Horizontal">
              <Button Content="◀" 
                      Command="{Binding PreviousDayCommand}" 
                      Margin="0,0,5,0" 
                      Padding="8,4"/>
              <TextBlock Text="{Binding SelectedDate, StringFormat='dddd, MMMM dd, yyyy'}" 
                         VerticalAlignment="Center" 
                         FontWeight="SemiBold" 
                         Margin="10,0"/>
              <Button Content="▶" 
                      Command="{Binding NextDayCommand}" 
                      Margin="5,0,0,0" 
                      Padding="8,4"/>
              <Button Content="Today" 
                      Command="{Binding TodayCommand}" 
                      Margin="15,0,0,0" 
                      Padding="8,4"/>
            </StackPanel>
          </StackPanel>
        </Border>
        
        <!-- Timeline Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto">
          <Grid x:Name="TimelineGrid" Background="White" Margin="10">
            <!-- Sites Layout -->
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
                           
              <!-- Sites Display -->
              <ScrollViewer Grid.Row="1" 
                            HorizontalScrollBarVisibility="Auto" 
                            VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SitesForSelectedDate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <GroupBox Margin="5,0">
                        <GroupBox.Header>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Site Icon -->
                            <TextBlock Text="{Binding Icon}"  
                                       FontSize="16" 
                                       Margin="0,0,8,0" 
                                       VerticalAlignment="Center"
                                       Foreground="#3B82F6"/>
                            <!-- Site Name -->
                            <TextBlock Text="{Binding Name}" 
                                       FontWeight="SemiBold" 
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </GroupBox.Header>
                        
                        <!-- Site Content Area -->
                        <Grid MinHeight="400" Background="#F8FAFC">
                          <!-- Program Meetings for this site -->
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ProgramMeetings}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <GroupBox Margin="5" 
                                            Background="White" 
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            AllowDrop="True"
                                            DragOver="ProgramMeeting_DragOver"
                                            Drop="ProgramMeeting_Drop">
                                    <GroupBox.Header>
                                      <StackPanel Orientation="Horizontal">
                                        <!-- Meeting Name -->
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="Bold" 
                                                   FontSize="12" 
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center"/>
                                        <!-- Meeting Date -->
                                        <TextBlock Text="{Binding ProgramDate, StringFormat=' - {0:dd/MM/yyyy}'}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="10" 
                                                   Foreground="#6B7280"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"/>
                                        <TextBlock FontSize="11"  Margin="5,0,0,0"
                                                     FontWeight="SemiBold"
                                                     Foreground="#059669">
                                          <TextBlock.Text>
                                            <MultiBinding StringFormat="De {0:HH:mm} à {1:HH:mm}">
                                              <Binding Path="BeginHour"/>
                                              <Binding Path="EndHour"/>
                                            </MultiBinding>
                                          </TextBlock.Text>
                                        </TextBlock>
                                      </StackPanel>
                                    </GroupBox.Header>
                                    
                                    <!-- Meeting Content -->
                                    <StackPanel Margin="8">
                                      <!-- Add Manual Slot Button -->
                                      <Button Content="+ Add Manual Slot" 
                                              Margin="0,0,0,8"
                                              Padding="8,4"
                                              FontSize="10"
                                              Background="#3B82F6" 
                                              Foreground="White" 
                                              BorderThickness="0"
                                              HorizontalAlignment="Left"
                                              Command="{Binding DataContext.AddManualSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                      
                                      <!-- Program Slots List -->
                                      <ItemsControl ItemsSource="{Binding OrderedProgramSlots}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate>
                                            <Border Background="#F8FAFC" 
                                                    BorderThickness="1" 
                                                    BorderBrush="#E2E8F0" 
                                                    Margin="0,2" 
                                                    Padding="8,4"
                                                    CornerRadius="3">
                                              <Grid>
                                                <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="Auto"/>
                                                  <ColumnDefinition Width="*"/>
                                                  <ColumnDefinition Width="Auto"/>
                                                  <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- NumberOfRun Badge (only show for race format slots, not manual ones) -->
                                                <Border Grid.Column="0" 
                                                        CornerRadius="2" 
                                                        Padding="3,1" 
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center">
                                                  <Border.Style>
                                                    <Style TargetType="Border">
                                                      <Setter Property="Background" Value="#3B82F6"/>
                                                      <Setter Property="Visibility" Value="Visible"/>
                                                      <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RaceFormatDetailId}" Value="-1">
                                                          <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RaceFormatDetail}" Value="{x:Null}">
                                                          <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                      </Style.Triggers>
                                                    </Style>
                                                  </Border.Style>
                                                  <TextBlock Text="{Binding RaceFormatDetail.NumberOfRun}" 
                                                             Foreground="White" 
                                                             FontWeight="Bold" 
                                                             FontSize="9"
                                                             HorizontalAlignment="Center"/>
                                                </Border>
                                                
                                                <!-- Slot Info -->
                                                <StackPanel Grid.Column="1">
                                                  <TextBlock Text="{Binding Name}" 
                                                             FontWeight="SemiBold" 
                                                             FontSize="10"
                                                             Foreground="#1F2937"/>
                                                  <TextBlock FontSize="9" 
                                                             Foreground="#6B7280">
                                                    <TextBlock.Text>
                                                      <MultiBinding StringFormat="{}{0:HH:mm} - {1:HH:mm}">
                                                        <Binding Path="BeginHour"/>
                                                        <Binding Path="EndHour"/>
                                                      </MultiBinding>
                                                    </TextBlock.Text>
                                                  </TextBlock>
                                                </StackPanel>
                                                
                                                <!-- Duration -->
                                                <TextBlock Grid.Column="2" 
                                                           FontSize="9" 
                                                           FontWeight="SemiBold"
                                                           Foreground="#059669"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0">
                                                  <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:F0} min">
                                                      <Binding Path="Duration"/>
                                                    </MultiBinding>
                                                  </TextBlock.Text>
                                                </TextBlock>
                                                
                                                <!-- Delete Button -->
                                                <Button Grid.Column="3"
                                                        Content="✕"
                                                        Width="20"
                                                        Height="20"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Background="#EF4444"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        ToolTip="Supprimer"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.DeleteSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                  <Button.Style>
                                                    <Style TargetType="Button">
                                                      <Setter Property="Template">
                                                        <Setter.Value>
                                                          <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="3"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                              <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                              <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#DC2626"/>
                                                              </Trigger>
                                                              <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="#B91C1C"/>
                                                              </Trigger>
                                                            </ControlTemplate.Triggers>
                                                          </ControlTemplate>
                                                        </Setter.Value>
                                                      </Setter>
                                                    </Style>
                                                  </Button.Style>
                                                </Button>
                                              </Grid>
                                            </Border>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </StackPanel>
                                  </GroupBox>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Grid>
                      </GroupBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </ScrollViewer>
      </Grid>

</Grid>
    
    <!-- Status Bar -->
    <Border Grid.Row="2" Background="#F9FAFB" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="10,5">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding EventCount, StringFormat='Events: {0}'}" Margin="0,0,20,0" FontSize="11"/>
        <TextBlock Text="{Binding LastValidationTime, StringFormat='Last Validated: {0:HH:mm:ss}'}" Margin="0,0,20,0" FontSize="11"/>
        <TextBlock Text="{Binding AutoSaveStatus}" FontSize="11" Foreground="#059669"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
